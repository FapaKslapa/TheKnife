<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="theknife.RecensioniRistoranteController" stylesheets="@style.css">
    <!-- Navbar -->
    <top>
        <HBox spacing="10" styleClass="hbox-navbar" BorderPane.alignment="TOP_CENTER">
            <Label fx:id="ristoranteTitle" text="Recensioni" styleClass="label-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="homeBtn" text="Home" styleClass="button-navbar"/>
        </HBox>
    </top>

    <!-- Sezione recensioni -->
    <center>
        <VBox spacing="24" alignment="TOP_CENTER" styleClass="recensioni-root" BorderPane.alignment="CENTER">
            <Label text="Recensioni degli utenti" styleClass="label-dialog-title"/>
            <Separator styleClass="separator"/>
            <!-- Form di modifica recensione (collassabile) -->
            <VBox fx:id="modificaRecensioneCard" spacing="12" styleClass="dialog-auth-card-slim"
                  visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Modifica Recensione" styleClass="label-auth-title-small"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="annullaModificaBtn" text="×" styleClass="button-close-mini" onAction="#annullaModificaRecensione"/>
                </HBox>
                <TextField fx:id="modTitoloField" promptText="Titolo recensione" styleClass="textfield-auth-compact"/>
                <TextArea fx:id="modTestoField" promptText="Modifica il testo della recensione..."
                     styleClass="textfield-auth-compact" prefRowCount="2"/>
                <HBox spacing="12" alignment="CENTER">
                    <Label text="Valutazione:" styleClass="label-info-modern"/>
                    <HBox fx:id="modStelleBox" spacing="2" alignment="CENTER" styleClass="stelle-rating-box"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="modRecResult" styleClass="label-auth-result" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="salvaModificaBtn" text="Salva" styleClass="button-auth-accent" onAction="#salvaModificaRecensione"/>
                </HBox>
            </VBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="recensioni-scroll" prefHeight="340" maxHeight="440">
                <content>
                    <FlowPane fx:id="recensioniCards" hgap="24" vgap="24" styleClass="recensioni-flow" prefWrapLength="900">
                        <padding>
                            <Insets top="20" right="24" bottom="20" left="24"/>
                        </padding>
                        <!-- Card recensioni generate dinamicamente -->
                    </FlowPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <!-- Sezione nuova recensione -->
    <bottom>
        <VBox fx:id="nuovaRecensioneCard" spacing="24" alignment="CENTER" styleClass="dialog-auth-card-slim">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>
            <Label text="Lascia una recensione" styleClass="label-auth-title-small"/>
            <Separator styleClass="separator"/>

            <TextField fx:id="titoloField" promptText="Titolo della recensione" styleClass="textfield-auth-compact"/>
            <TextArea fx:id="testoField" promptText="Scrivi qui la tua recensione..."
                     styleClass="textfield-auth-compact" prefRowCount="3"/>

            <HBox spacing="32" alignment="CENTER">
                <Label text="Voto:" styleClass="label-info-modern"/>
                <HBox fx:id="stelleBox" spacing="8" alignment="CENTER_LEFT" styleClass="stelle-rating-box"/>
            </HBox>

            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="confermaBtn" text="Conferma" styleClass="button-auth-accent"/>
                <Label fx:id="resultLabel" styleClass="label-auth-result"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
