<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="theknife.MainViewController" stylesheets="@style.css">
    <VBox spacing="0" alignment="TOP_CENTER" StackPane.alignment="TOP_CENTER">
        <HBox spacing="10" styleClass="hbox-navbar">
            <Label text="TheKnife" styleClass="label-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="loginBtn" text="Accedi" styleClass="button-navbar"/>
            <Button fx:id="registerBtn" text="Registrati" styleClass="button-navbar"/>
        </HBox>

        <!-- Pannello filtri -->
        <VBox styleClass="filtri-panel" spacing="15">
            <padding>
                <Insets top="20" right="32" bottom="15" left="32"/>
            </padding>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Filtri di ricerca" styleClass="filtri-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="resetFiltriBtn" text="Reset" styleClass="button-reset"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <!-- Nome ristorante -->
                <VBox spacing="5">
                    <Label text="Nome ristorante" styleClass="filtri-label"/>
                    <TextField fx:id="nomeRistoranteField" promptText="Cerca per nome..." prefWidth="200"/>
                </VBox>
                <!-- Tipo cucina -->
                <VBox spacing="5">
                    <Label text="Tipo di cucina" styleClass="filtri-label"/>
                    <ComboBox fx:id="tipoCucinaCombo" prefWidth="150" promptText="Seleziona..."/>
                </VBox>

                <!-- Fascia prezzo -->
                <VBox spacing="5">
                    <Label text="Fascia di prezzo" styleClass="filtri-label"/>
                    <ComboBox fx:id="fasciaPrezzoCombo" prefWidth="150" promptText="Seleziona..."/>
                </VBox>

                <!-- Consegna a domicilio -->
                <VBox spacing="5">
                    <Label text="Servizi" styleClass="filtri-label"/>
                    <CheckBox fx:id="consegnaCheckbox" text="Consegna a domicilio"/>
                </VBox>

                <!-- Aperto ora -->
                <VBox spacing="5">
                    <Label text="Disponibilità" styleClass="filtri-label"/>
                    <CheckBox fx:id="apertoOraCheckbox" text="Aperto ora"/>
                </VBox>

                <!-- Posizione -->
                <VBox spacing="5">
                    <Label text="Posizione" styleClass="filtri-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="posizioneField" promptText="Inserisci indirizzo" prefWidth="200"/>
                        <ComboBox fx:id="distanzaCombo" prefWidth="120" promptText="Distanza"/>
                    </HBox>
                </VBox>

                <!-- Bottone ricerca -->
                <Button fx:id="cercaBtn" text="Cerca" styleClass="button-cerca"/>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="ristorantiPane" hgap="32" vgap="32" styleClass="ristoranti-flow">
                <padding>
                    <Insets top="32" right="32" bottom="32" left="32"/>
                </padding>
            </FlowPane>
        </ScrollPane>
        <HBox fx:id="paginationBox" spacing="12" alignment="CENTER" styleClass="pagination-bar">
            <Button fx:id="prevPageBtn" styleClass="icon-btn" disable="false">
                <graphic>
                    <SVGPath content="M15 19l-7-7 7-7" styleClass="icon-navbar"/>
                </graphic>
            </Button>
            <Label fx:id="pageLabel" text="Pagina 1" styleClass="pagination-label"/>
            <Button fx:id="nextPageBtn" styleClass="icon-btn" disable="false">
                <graphic>
                    <SVGPath content="M9 5l7 7-7 7" styleClass="icon-navbar"/>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</StackPane>
