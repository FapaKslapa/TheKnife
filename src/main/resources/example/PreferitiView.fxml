<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="example.PreferitiController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Gestione Preferiti"/>
    <TextField fx:id="userIdField" promptText="User ID"/>
    <TextField fx:id="ristoranteIdField" promptText="Ristorante ID"/>
    <Button text="Aggiungi ai preferiti" onAction="#onAggiungiPreferito"/>
    <Button text="Rimuovi dai preferiti" onAction="#onRimuoviPreferito"/>
    <Button text="Mostra preferiti" onAction="#onShowPreferiti"/>
    <ListView fx:id="preferitiList"/>
    <Label fx:id="preferitiResult"/>
</VBox>