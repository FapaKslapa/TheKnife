<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="example.PreferitiViewController" stylesheets="@style.css">
    <VBox spacing="0" alignment="TOP_CENTER" StackPane.alignment="TOP_CENTER">
        <HBox spacing="10" styleClass="hbox-navbar">
            <Label text="Preferiti" styleClass="label-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="homeBtn" text="Home" styleClass="button-navbar"/>
        </HBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <FlowPane fx:id="preferitiPane" hgap="32" vgap="32" styleClass="ristoranti-flow">
                <padding>
                    <Insets top="32" right="32" bottom="32" left="32"/>
                </padding>
                <!-- Card preferiti generate dinamicamente -->
            </FlowPane>
        </ScrollPane>
    </VBox>
</StackPane>

