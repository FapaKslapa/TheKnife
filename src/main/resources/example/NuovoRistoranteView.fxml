<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="example.NuovoRistoranteController" stylesheets="@style.css">
    <VBox spacing="0" alignment="TOP_CENTER" StackPane.alignment="TOP_CENTER">
        <HBox spacing="10" styleClass="hbox-navbar">
            <Label text="TheKnife" styleClass="label-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="annullaBtn" text="Annulla" styleClass="button-navbar"/>
            <Button fx:id="confermaBtn" text="Conferma" styleClass="button-navbar"/>
        </HBox>
        <StackPane VBox.vgrow="ALWAYS" alignment="CENTER">
            <VBox spacing="28" alignment="CENTER" styleClass="dialog-ristorante-card-wide" maxWidth="720">
                <Label text="Crea un nuovo ristorante" styleClass="label-auth-title-large"/>
                <VBox spacing="18" alignment="CENTER_LEFT" styleClass="form-ristorante-fields">
                    <TextField fx:id="nomeField" promptText="Nome del ristorante" styleClass="textfield-auth-wide"/>
                    <TextField fx:id="tipoCucinaField" promptText="Tipo di cucina (es. Pizza, Sushi...)" styleClass="textfield-auth-wide"/>
                    <HBox spacing="18" alignment="CENTER_LEFT">
                        <Label text="Fascia prezzo:" styleClass="label-info-modern"/>
                        <ComboBox fx:id="fasciaPrezzoBox" styleClass="textfield-auth-wide"/>
                    </HBox>
                    <TextField fx:id="telefonoField" promptText="Telefono" styleClass="textfield-auth-wide"/>
                    <TextField fx:id="indirizzoField" promptText="Indirizzo completo" styleClass="textfield-auth-wide"/>
                    <HBox spacing="18" alignment="CENTER_LEFT">
                        <Label text="Consegna a domicilio:" styleClass="label-info-modern"/>
                        <CheckBox fx:id="consegnaCheck"/>
                    </HBox>
                </VBox>
                <Label text="Orari di apertura" styleClass="label-info-modern"/>
                <ScrollPane fitToWidth="true" fitToHeight="false" maxHeight="320" minHeight="220" styleClass="orari-scroll-wrapper-modern">
                    <VBox fx:id="orariBox" spacing="18" alignment="TOP_CENTER" styleClass="orari-vbox-creazione">
                        <!-- Card orari generate dal controller -->
                    </VBox>
                </ScrollPane>
                <Label fx:id="resultLabel" styleClass="label-auth-result"/>
            </VBox>
        </StackPane>
    </VBox>
</StackPane>
