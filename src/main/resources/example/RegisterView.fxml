<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<VBox fx:id="rootVBox" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="example.RegisterController"
      stylesheets="@style.css"
      styleClass="auth-root-stack"
      alignment="TOP_CENTER"
      spacing="0">
    <!-- Navbar in alto -->
    <HBox spacing="10" styleClass="hbox-navbar" alignment="CENTER_LEFT">
        <Button text="Home" fx:id="homeBtn" styleClass="button-navbar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Accedi" fx:id="loginBtn" styleClass="button-navbar"/>
    </HBox>
    <!-- Card centrata -->
    <StackPane VBox.vgrow="ALWAYS" alignment="CENTER">
        <VBox fx:id="registerCard" spacing="14" alignment="CENTER"
              styleClass="dialog-auth-card">
            <padding>
                <Insets top="28" right="36" bottom="28" left="36"/>
            </padding>
            <Label text="Registrati" styleClass="label-auth-title"/>
            <TextField fx:id="usernameField" promptText="Username" styleClass="textfield-auth"/>
            <TextField fx:id="emailField" promptText="Email" styleClass="textfield-auth"/>
            <PasswordField fx:id="passwordField" promptText="Password" styleClass="passwordfield-auth"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Conferma Password" styleClass="passwordfield-auth"/>
            <ComboBox fx:id="ruoloBox" promptText="Ruolo" styleClass="textfield-auth"/>
            <Button text="Registrati" styleClass="button-auth" onAction="#onRegister"/>
            <Label fx:id="registerResult" styleClass="label-auth-result"/>
        </VBox>
    </StackPane>
    <!-- Link sotto la card -->
    <Label text="Hai già un account? Accedi" fx:id="loginLink" styleClass="label-auth-link" alignment="CENTER"/>
</VBox>
<!-- Fine -->
